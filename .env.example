# OpenAI-compatible endpoint used by cmd/agent-loop and `make record-openai`.
LLM_BASE_URL=https://tokenplan.api.greennode.ai/v1
LLM_API_KEY=
LLM_MODEL=z-ai/glm-5.3
# Optional cost units per million input,cached_input,output tokens (e.g. micro-dollars).
LLM_PRICE=
# Embeddings for the memory tools (memory.save, memory.search), e.g. Dockerized Ollama
# from `docker compose -f docker-compose.test.yml up -d ollama` + `ollama pull nomic-embed-text`.
# Use LLM_EMBED_MODEL instead to embed on the endpoint above.
OLLAMA_EMBED_MODEL=
OLLAMA_BASE_URL=http://localhost:41434
# session (default), workflow or tenant: who can recall what agents save.
MEMORY_WRITE_SCOPE=
